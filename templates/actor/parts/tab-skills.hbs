<section class="tab {{tabs.skills.cssClass}} p-2 overflow-y-auto" data-tab="{{tabs.skills.id}}" data-group="{{tabs.skills.group}}">
 <div class="flex flex-col gap-2">

  {{#each skillsByCategory}}
    <details open class="border rounded">
      <summary class="cursor-pointer select-none px-2 py-1 font-l5r-display text-sm uppercase tracking-wide bg-black/5">
        {{localize this.labelKey}}
      </summary>

      <div class="flex flex-col divide-y divide-black/5 p-1">
        {{#each this.skills}}

          {{#if this.isGroup}}
            {{!-- Compétence à sous-types (Connaissance, Spectacle...) : groupe dépliable --}}
            <details class="py-1">
              <summary class="cursor-pointer select-none text-sm font-semibold py-0.5 flex items-center gap-2">
                <span>{{this.name}} <span class="text-xs text-neutral-400">({{this.entries.length}})</span></span>
                {{#if this.showAddSubtype}}
                  <button type="button" class="flex items-center justify-center w-5 h-5 rounded text-neutral-500 hover:text-l5r-accent"
                          data-action="addSubtype" data-item-id="{{this.entries.[0].id}}"
                          title="{{localize 'L5R4EC.Sheet.AddSubtype'}}">
                    <i class="fa-solid fa-plus"></i>
                  </button>
                {{/if}}
              </summary>
              <div class="flex flex-col gap-1 pl-4 pt-1">
                {{#each this.entries}}
                  <div class="grid grid-cols-[16px_1fr_5.5rem_2.75rem_1.5rem_1.75rem] gap-2 items-center text-sm">
                    <input type="checkbox" data-item-id="{{this.id}}" data-item-field="system.isSchoolSkill"
                           {{#if this.isSchoolSkill}}checked{{/if}} title="{{localize 'L5R4EC.Sheet.SchoolSkill'}}">

                    <input type="text" data-item-id="{{this.id}}" data-item-field="system.subtype"
                           value="{{this.subtype}}" placeholder="{{localize 'L5R4EC.Sheet.Subtype'}}"
                           class="italic border rounded px-1 min-w-0">

                    <select data-item-id="{{this.id}}" data-item-field="system.trait" class="border rounded text-xs px-1 py-0.5">
                      {{#each this.traitOptions}}
                        <option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{localize this.labelKey}}</option>
                      {{/each}}
                    </select>

                    <span class="flex items-center justify-center gap-1">
                      <input type="number" data-item-id="{{this.id}}" data-item-field="system.rank"
                             value="{{this.rank}}" min="0" class="w-full border rounded text-center">
                      {{#if this.freeAugment}}
                        <i class="fa-solid fa-star text-amber-500 text-xs shrink-0" title="{{localize 'L5R4EC.Sheet.FreeAugmentHint'}}"></i>
                      {{/if}}
                    </span>

                    <button type="button" class="flex items-center justify-center text-neutral-500 hover:text-l5r-accent"
                            data-action="showSkillInfo" data-item-id="{{this.id}}" title="{{localize 'L5R4EC.Sheet.SkillInfo'}}">
                      <i class="fa-solid fa-circle-info"></i>
                    </button>

                    <button type="button"
                            class="w-7 h-7 flex items-center justify-center rounded bg-l5r-accent text-white hover:bg-l5r-accent-light"
                            data-action="rollSkill" data-item-id="{{this.id}}" title="{{localize 'L5R4EC.Sheet.SkillRoll'}}">
                      <i class="fa-solid fa-dice-d10 text-xs"></i>
                    </button>
                  </div>

                  <div class="pl-4">
                    <input type="text" data-item-id="{{this.id}}" data-item-field="system.specializations"
                           value="{{this.specializations}}" placeholder="{{localize 'L5R4EC.Sheet.Specializations'}}"
                           class="w-full text-xs border rounded px-1 text-neutral-500">
                  </div>
                {{/each}}
              </div>
            </details>
          {{else}}
            {{!-- Compétence simple --}}
            <div class="py-1">
              <div class="grid {{#if this.showAddSubtype}}grid-cols-[16px_1fr_5.5rem_2.75rem_1.5rem_1.5rem_1.75rem]{{else}}grid-cols-[16px_1fr_5.5rem_2.75rem_1.5rem_1.75rem]{{/if}} gap-2 items-center text-sm">
                <input type="checkbox" data-item-id="{{this.id}}" data-item-field="system.isSchoolSkill"
                       {{#if this.isSchoolSkill}}checked{{/if}} title="{{localize 'L5R4EC.Sheet.SchoolSkill'}}">

                <span class="truncate" title="{{this.name}}">{{this.name}}</span>

                <select data-item-id="{{this.id}}" data-item-field="system.trait" class="border rounded text-xs px-1 py-0.5">
                  {{#each this.traitOptions}}
                    <option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{localize this.labelKey}}</option>
                  {{/each}}
                </select>

                <span class="flex items-center justify-center gap-1">
                  <input type="number" data-item-id="{{this.id}}" data-item-field="system.rank"
                         value="{{this.rank}}" min="0" class="w-full border rounded text-center">
                  {{#if this.freeAugment}}
                    <i class="fa-solid fa-star text-amber-500 text-xs shrink-0" title="{{localize 'L5R4EC.Sheet.FreeAugmentHint'}}"></i>
                  {{/if}}
                </span>

                {{#if this.showAddSubtype}}
                  <button type="button" class="flex items-center justify-center text-neutral-500 hover:text-l5r-accent"
                          data-action="addSubtype" data-item-id="{{this.id}}" title="{{localize 'L5R4EC.Sheet.AddSubtype'}}">
                    <i class="fa-solid fa-plus"></i>
                  </button>
                {{/if}}

                <button type="button" class="flex items-center justify-center text-neutral-500 hover:text-l5r-accent"
                        data-action="showSkillInfo" data-item-id="{{this.id}}" title="{{localize 'L5R4EC.Sheet.SkillInfo'}}">
                  <i class="fa-solid fa-circle-info"></i>
                </button>

                <button type="button"
                        class="w-7 h-7 flex items-center justify-center rounded bg-l5r-accent text-white hover:bg-l5r-accent-light"
                        data-action="rollSkill" data-item-id="{{this.id}}" title="{{localize 'L5R4EC.Sheet.SkillRoll'}}">
                  <i class="fa-solid fa-dice-d10 text-xs"></i>
                </button>
              </div>

              {{!-- Sous-type : seulement pour les Compétences qui en ont vraiment
                   (voir SUBTYPE_SKILL_NAMES) - affiché en permanence pour
                   celles-là (pas seulement une fois déjà renseigné, sinon la
                   seule façon d'en donner un premier est "+" (addSubtype), qui
                   crée une toute nouvelle Compétence au lieu d'éditer
                   celle-ci). Les autres Compétences n'en ont simplement pas. --}}
              <div class="pl-4 mt-0.5 flex gap-2">
                {{#if this.hasSubtype}}
                  <input type="text" data-item-id="{{this.id}}" data-item-field="system.subtype"
                         value="{{this.subtype}}" placeholder="{{localize 'L5R4EC.Sheet.Subtype'}}"
                         class="w-1/3 text-xs italic border rounded px-1 text-neutral-500">
                {{/if}}
                <input type="text" data-item-id="{{this.id}}" data-item-field="system.specializations"
                       value="{{this.specializations}}" placeholder="{{localize 'L5R4EC.Sheet.Specializations'}}"
                       class="flex-1 text-xs border rounded px-1 text-neutral-500">
              </div>
            </div>
          {{/if}}

        {{/each}}
      </div>
    </details>
  {{/each}}

  {{#if isGM}}
    <div class="flex gap-1 mt-1">
      <button type="button" data-action="addSkill"
              class="self-start text-xs px-2 py-1 rounded border border-l5r-accent text-l5r-accent hover:bg-l5r-accent hover:text-white">
        <i class="fa-solid fa-plus"></i> {{localize "L5R4EC.Sheet.AddSkill"}}
      </button>
      <button type="button" data-action="resyncSkills"
              class="self-start text-xs px-2 py-1 rounded border border-neutral-400 text-neutral-600 hover:border-l5r-accent hover:text-l5r-accent"
              title="{{localize 'L5R4EC.Sheet.ResyncSkillsHint'}}">
        <i class="fa-solid fa-rotate"></i> {{localize "L5R4EC.Sheet.ResyncSkills"}}
      </button>
    </div>
  {{/if}}
 </div>
</section>
