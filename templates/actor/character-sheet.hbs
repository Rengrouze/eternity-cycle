<div class="l5r4ec character-sheet flex flex-col gap-3 p-2">

  {{!-- En-tête : nom, clan, famille, école --}}
  <header class="flex gap-3 items-start">
    <img class="w-24 h-24 object-cover border border-black/30" src="{{actor.img}}" data-edit="img" data-action="editImage" alt="{{actor.name}}">

    <div class="flex-1 flex flex-col gap-2">
      <input type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'L5R4EC.Details.Name'}}"
             class="text-xl font-bold font-l5r-display bg-transparent border-b border-black/20 px-1">

      <div class="flex gap-3">
        <label class="flex flex-col text-xs gap-0.5">{{localize "L5R4EC.Details.Clan"}}
          <input type="text" name="system.details.clan" value="{{system.details.clan}}" class="border rounded px-1 py-0.5">
        </label>
        <label class="flex flex-col text-xs gap-0.5">{{localize "L5R4EC.Details.Family"}}
          <input type="text" name="system.details.family" value="{{system.details.family}}" class="border rounded px-1 py-0.5">
        </label>
        <label class="flex flex-col text-xs gap-0.5">{{localize "L5R4EC.Details.School"}}
          <input type="text" name="system.details.school" value="{{system.details.school}}" class="border rounded px-1 py-0.5">
        </label>
      </div>
    </div>
  </header>

  {{!-- Anneaux + Traits --}}
  <section>
    <h2 class="text-lg font-l5r-display border-b border-l5r-accent mb-2">{{localize "L5R4EC.Sheet.RingsAndTraits"}}</h2>
    <div class="grid grid-cols-3 gap-2">

      {{#each ringGroups}}
        <div class="border rounded p-2 flex flex-col gap-1">
          <h3 class="flex justify-between font-semibold">
            {{localize this.labelKey}}
            <span class="text-l5r-accent font-bold">{{this.rank}}</span>
          </h3>
          {{#each this.traits}}
            <label class="flex justify-between items-center gap-2 text-sm">
              {{localize this.labelKey}}
              <span class="flex items-center gap-1">
                <input type="number" name="system.traits.{{this.key}}" value="{{this.value}}" min="1"
                       class="w-12 border rounded text-center">
                <button type="button"
                        class="w-7 h-7 flex items-center justify-center rounded bg-l5r-accent text-white hover:bg-l5r-accent-light"
                        data-action="rollTrait" data-trait="{{this.key}}"
                        title="{{localize 'L5R4EC.Sheet.TraitRoll'}}">
                  <i class="fa-solid fa-dice-d10"></i>
                </button>
              </span>
            </label>
          {{/each}}
        </div>
      {{/each}}

      {{!-- Vide : rang manuel, hors boucle car pas de Traits associés --}}
      <div class="border rounded p-2 flex flex-col gap-1 bg-black/5">
        <h3 class="font-semibold">{{localize "L5R4EC.Ring.Void"}}</h3>
        <label class="flex justify-between items-center text-sm">{{localize "L5R4EC.Sheet.Rank"}}
          <input type="number" name="system.rings.void.rank" value="{{system.rings.void.rank}}" min="0" class="w-12 border rounded text-center">
        </label>
        <label class="flex justify-between items-center text-sm">{{localize "L5R4EC.Sheet.Value"}}
          <input type="number" name="system.rings.void.value" value="{{system.rings.void.value}}" min="0" class="w-12 border rounded text-center">
        </label>
      </div>

    </div>
  </section>

  {{!-- Blessures + Honneur --}}
  <section class="flex gap-6">
    <div>
      <h2 class="text-lg font-l5r-display border-b border-l5r-accent mb-2">{{localize "L5R4EC.Sheet.Wounds"}}</h2>
      <label class="flex items-center gap-1 text-sm">
        <input type="number" name="system.wounds.value" value="{{system.wounds.value}}" min="0" class="w-12 border rounded text-center">
        /
        <input type="number" name="system.wounds.max" value="{{system.wounds.max}}" min="0" class="w-12 border rounded text-center">
      </label>
    </div>

    <div>
      <h2 class="text-lg font-l5r-display border-b border-l5r-accent mb-2">{{localize "L5R4EC.Sheet.Honor"}}</h2>
      <div class="flex gap-3">
        <label class="flex flex-col text-xs gap-0.5">{{localize "L5R4EC.Sheet.Rank"}}
          <input type="number" name="system.honor.rank" value="{{system.honor.rank}}" min="0" class="w-16 border rounded px-1 py-0.5">
        </label>
        <label class="flex flex-col text-xs gap-0.5">{{localize "L5R4EC.Sheet.Points"}}
          <input type="number" name="system.honor.points" value="{{system.honor.points}}" step="0.1" class="w-16 border rounded px-1 py-0.5">
        </label>
      </div>
    </div>
  </section>

  {{!-- Biographie --}}
  <section>
    <h2 class="text-lg font-l5r-display border-b border-l5r-accent mb-2">{{localize "L5R4EC.Details.Biography"}}</h2>
    <div class="editor-content min-h-32 border rounded p-2" data-field="system.details.biography">
      {{{enrichedBiography}}}
    </div>
  </section>

</div>
