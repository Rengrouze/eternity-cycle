<div class="flex flex-col gap-2 p-1 w-72">
  <label class="flex flex-col gap-0.5 text-sm">
    {{localize "L5R4EC.Sheet.ItemName"}}
    <input type="text" name="name" required autofocus class="border rounded px-1 py-0.5">
  </label>

  <label class="flex flex-col gap-0.5 text-sm">
    {{localize "L5R4EC.Sheet.AssociatedSkill"}}
    <input type="text" name="associatedSkill" class="border rounded px-1 py-0.5" placeholder="{{localize 'L5R4EC.Dialog.OptionalHint'}}">
  </label>

  <label class="flex flex-col gap-0.5 text-sm">
    {{localize "L5R4EC.Sheet.Quality"}}
    <select name="quality" class="border rounded px-1 py-0.5">
      {{#each qualityOptions}}
        <option value="{{this.key}}">{{localize this.labelKey}}</option>
      {{/each}}
    </select>
  </label>
</div>
