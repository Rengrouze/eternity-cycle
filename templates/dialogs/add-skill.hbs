<div class="flex flex-col gap-2 p-1 w-72">
  <label class="flex flex-col gap-0.5 text-sm">
    {{localize "L5R4EC.Dialog.SkillName"}}
    <input type="text" name="name" required class="border rounded px-1 py-0.5" placeholder="{{localize 'L5R4EC.Dialog.SkillNameHint'}}">
  </label>

  <label class="flex flex-col gap-0.5 text-sm">
    {{localize "L5R4EC.Sheet.Category"}}
    <select name="category" class="border rounded px-1 py-0.5">
      {{#each categories}}
        <option value="{{this.key}}">{{localize this.labelKey}}</option>
      {{/each}}
    </select>
  </label>

  <label class="flex flex-col gap-0.5 text-sm">
    {{localize "L5R4EC.Sheet.Trait"}}
    <select name="trait" class="border rounded px-1 py-0.5">
      {{#each traitOptions}}
        <option value="{{this.key}}">{{localize this.labelKey}}</option>
      {{/each}}
    </select>
  </label>

  <label class="flex flex-col gap-0.5 text-sm">
    {{localize "L5R4EC.Sheet.Subtype"}}
    <input type="text" name="subtype" class="border rounded px-1 py-0.5" placeholder="{{localize 'L5R4EC.Dialog.SubtypeHint'}}">
  </label>

  <label class="flex items-center gap-2 text-sm">
    <input type="checkbox" name="isSchoolSkill">
    {{localize "L5R4EC.Sheet.SchoolSkill"}}
  </label>
</div>
