<div class="l5r4ec chat-card flex flex-col gap-2 p-1">

  <header class="flex justify-between items-start gap-2">
    <strong class="font-l5r-display">{{localize "L5R4EC.Chat.DamageRequestTitle"}}</strong>
  </header>

  <div class="text-sm">
    <strong>{{attackerName}}</strong> → <strong>{{targetName}}</strong> : {{amount}} {{localize "L5R4EC.Chat.DamagePoints"}}
  </div>

  {{#if pending}}
    <div class="flex gap-2">
      <button type="button" data-action="approveDamageApplication"
              class="flex-1 flex items-center justify-center gap-1 text-sm px-2 py-1 rounded border border-green-600 text-green-700 hover:bg-green-600 hover:text-white">
        <i class="fa-solid fa-check"></i> {{localize "L5R4EC.Chat.Approve"}}
      </button>
      <button type="button" data-action="rejectDamageApplication"
              class="flex-1 flex items-center justify-center gap-1 text-sm px-2 py-1 rounded border border-red-600 text-red-700 hover:bg-red-600 hover:text-white">
        <i class="fa-solid fa-xmark"></i> {{localize "L5R4EC.Chat.Reject"}}
      </button>
    </div>
  {{else}}
    <div class="text-xs font-bold {{#if approved}}text-green-600{{else}}text-red-600{{/if}}">
      {{#if approved}}{{localize "L5R4EC.Chat.DamageApplied"}} ({{appliedAmount}}){{else}}{{localize "L5R4EC.Chat.Rejected"}}{{/if}}
    </div>
  {{/if}}

</div>
