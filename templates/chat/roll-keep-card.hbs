<div class="l5r4ec chat-card flex flex-col gap-2 p-1">

  <header class="flex justify-between items-start gap-2">
    <strong class="font-l5r-display min-w-0">{{flavor}}</strong>
    <span class="text-xl font-bold text-l5r-accent shrink-0 whitespace-nowrap">{{keptTotal}}</span>
  </header>

  {{#if spellInfo}}
    <div class="text-xs text-neutral-600 border rounded px-2 py-1 bg-black/5 flex flex-col gap-0.5">
      <div>{{spellInfo.ring}} {{spellInfo.masteryRank}}{{#if spellInfo.keywords}} — {{spellInfo.keywords}}{{/if}}</div>
      <div>{{localize "L5R4EC.Sheet.SpellRange"}} : {{spellInfo.range}} · {{localize "L5R4EC.Sheet.AreaOfEffect"}} : {{spellInfo.areaOfEffect}} · {{localize "L5R4EC.Sheet.Duration"}} : {{spellInfo.duration}}</div>
      {{#if spellInfo.raises}}
        <div>{{localize "L5R4EC.Sheet.Raises"}} : {{spellInfo.raises}}</div>
      {{/if}}
    </div>
  {{/if}}

  {{#if weaponInfo}}
    <div class="text-xs text-neutral-600 border rounded px-2 py-1 bg-black/5 flex flex-col gap-0.5">
      <div>{{localize "L5R4EC.Sheet.AssociatedSkill"}} : {{weaponInfo.associatedSkill}}</div>
      <div>{{localize "L5R4EC.Sheet.DamageRoll"}} : {{weaponInfo.dr}}</div>
      {{#if preciseTarget}}<div>{{localize "L5R4EC.Chat.PreciseTargetHit"}} : {{preciseTarget}}</div>{{/if}}
    </div>
  {{/if}}

  {{#if rolled}}
    <div class="text-xs font-mono text-neutral-500">{{rolled}}g{{kept}}</div>
  {{/if}}

  <div class="flex flex-wrap gap-1">
    {{#each keptDice}}
      <span class="relative inline-flex items-center justify-center min-w-[1.9rem] h-8 px-1 rounded border text-sm font-bold
        {{#if this.exploded}}
          border-green-600 bg-green-100 text-green-800
        {{else if this.isFinalOne}}
          border-red-600 bg-red-100 text-red-700
        {{else}}
          border-black/20 bg-white text-black
        {{/if}}">
        {{#if this.discardedOne}}
          <span class="absolute -top-2 -left-1 text-[0.6rem] leading-none px-1 rounded-full bg-neutral-200 text-neutral-400 line-through">1</span>
        {{/if}}
        {{this.total}}
      </span>
    {{/each}}
  </div>

  {{#if discardedDice.length}}
    <div class="flex flex-wrap gap-1 opacity-40">
      {{#each discardedDice}}
        <span class="inline-flex items-center justify-center min-w-[1.9rem] h-7 px-1 rounded border border-black/10 bg-black/5 text-xs">
          {{this.total}}
        </span>
      {{/each}}
    </div>
  {{/if}}

  {{#if flatBonus}}
    <div class="text-xs text-neutral-500">
      {{localize "L5R4EC.Chat.FlatBonus"}} : +{{flatBonus}}
    </div>
  {{/if}}

  {{#if woundPenalty}}
    <div class="text-xs text-red-500">
      {{localize "L5R4EC.Chat.WoundPenalty"}} : {{woundPenalty}}
    </div>
  {{/if}}

  {{#if targetTN}}
    <div class="flex items-center justify-between text-sm border rounded px-2 py-1
      {{#if success}}border-green-600 bg-green-50 text-green-700{{else}}border-red-600 bg-red-50 text-red-700{{/if}}">
      <span>{{localize "L5R4EC.Chat.TargetTn"}} {{targetTN}}
        {{#if augmentations}}({{augmentations}} {{localize "L5R4EC.Chat.AugmentationsDeclared"}}){{/if}}
        {{#if targets}}· {{targets}} {{localize "L5R4EC.Chat.Targets"}}{{/if}}
        {{#if targetName}}· {{localize "L5R4EC.Chat.Target"}} : {{targetName}}{{/if}}
      </span>
      <strong>{{#if success}}{{localize "L5R4EC.Chat.Success"}}{{else}}{{localize "L5R4EC.Chat.Failure"}}{{/if}}</strong>
    </div>
  {{else if augmentations}}
    <div class="text-xs text-neutral-500">
      {{augmentations}} {{localize "L5R4EC.Chat.AugmentationsDeclared"}} ({{localize "L5R4EC.Chat.AugmentationsNoTargetHint"}})
    </div>
  {{/if}}

  {{#if damageButton}}
    <button type="button" data-action="rollDamage"
            data-actor-id="{{damageButton.actorId}}"
            data-item-name="{{damageButton.itemName}}"
            data-rolled="{{damageButton.rolled}}"
            data-kept="{{damageButton.kept}}"
            data-explode-on="{{damageButton.explodeOn}}"
            data-flat-bonus="{{damageButton.flatBonus}}"
            data-note="{{damageButton.note}}"
            data-target-actor-id="{{damageButton.targetActorId}}"
            class="flex items-center justify-center gap-2 text-sm px-2 py-1 rounded border border-l5r-accent text-l5r-accent hover:bg-l5r-accent hover:text-white">
      <i class="fa-solid fa-fire"></i> {{localize "L5R4EC.Chat.RollDamage"}} ({{damageButton.rolled}}k{{damageButton.kept}}{{#if damageButton.flatBonus}}+{{damageButton.flatBonus}}{{/if}})
    </button>
    {{#if damageButton.note}}
      <div class="text-[0.65rem] text-neutral-400 italic">{{localize "L5R4EC.Chat.DamageNote"}} : {{damageButton.note}}</div>
    {{/if}}
  {{/if}}

  {{#if applyDamageButton}}
    <button type="button" data-action="applyDamage"
            data-attacker-actor-id="{{applyDamageButton.attackerActorId}}"
            data-target-actor-id="{{applyDamageButton.targetActorId}}"
            data-amount="{{applyDamageButton.amount}}"
            class="flex items-center justify-center gap-2 text-sm px-2 py-1 rounded border border-red-600 text-red-700 hover:bg-red-600 hover:text-white">
      <i class="fa-solid fa-heart-crack"></i> {{localize "L5R4EC.Chat.ApplyDamage"}} ({{applyDamageButton.targetName}}, {{applyDamageButton.amount}})
    </button>
  {{/if}}

  {{#if extraAttackButton}}
    <button type="button" data-action="rollAttackAgain"
            data-actor-id="{{extraAttackButton.actorId}}"
            data-weapon-id="{{extraAttackButton.weaponId}}"
            class="flex items-center justify-center gap-2 text-sm px-2 py-1 rounded border border-l5r-accent text-l5r-accent hover:bg-l5r-accent hover:text-white">
      <i class="fa-solid fa-khanda"></i> {{localize "L5R4EC.Chat.RollAttackAgain"}}
    </button>
  {{/if}}

  {{#if disarmResult}}
    <div class="text-xs border rounded px-2 py-1 {{#if disarmResult.attackerWins}}border-green-600 bg-green-50 text-green-700{{else}}border-neutral-400 bg-black/5 text-neutral-600{{/if}}">
      {{localize "L5R4EC.Chat.ContestedForce"}} - {{localize "L5R4EC.Chat.AttackerRoll"}} {{disarmResult.attackerTotal}} vs {{disarmResult.targetName}} {{disarmResult.targetTotal}} :
      {{#if disarmResult.attackerWins}}{{localize "L5R4EC.Chat.DisarmSuccess"}}{{else}}{{localize "L5R4EC.Chat.DisarmFailure"}}{{/if}}
    </div>
  {{/if}}

  {{#if reversalResult}}
    <div class="text-xs border rounded px-2 py-1 {{#if reversalResult.attackerWins}}border-green-600 bg-green-50 text-green-700{{else}}border-neutral-400 bg-black/5 text-neutral-600{{/if}}">
      {{localize "L5R4EC.Chat.ContestedForce"}} - {{localize "L5R4EC.Chat.AttackerRoll"}} {{reversalResult.attackerTotal}} vs {{reversalResult.targetName}} {{reversalResult.targetTotal}} :
      {{#if reversalResult.attackerWins}}{{localize "L5R4EC.Chat.ReversalSuccess"}}{{else}}{{localize "L5R4EC.Chat.ReversalFailure"}}{{/if}}
    </div>
  {{/if}}

  {{#if voidRecoveryButton}}
    <button type="button" data-action="recoverVoid"
            data-actor-id="{{voidRecoveryButton.actorId}}"
            data-amount="{{voidRecoveryButton.amount}}"
            class="flex items-center justify-center gap-2 text-sm px-2 py-1 rounded border border-l5r-accent text-l5r-accent hover:bg-l5r-accent hover:text-white">
      <i class="fa-solid fa-yin-yang"></i> {{localize "L5R4EC.Chat.RecoverVoid"}} ({{voidRecoveryButton.amount}})
    </button>
  {{/if}}

  <div class="flex gap-3 text-[0.65rem] text-neutral-400 border-t border-black/10 pt-1">
    <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-green-500"></span>{{localize "L5R4EC.Chat.LegendExplode"}}</span>
    <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-red-500"></span>{{localize "L5R4EC.Chat.LegendOne"}}</span>
    <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-neutral-300"></span>{{localize "L5R4EC.Chat.LegendReroll"}}</span>
  </div>

</div>
