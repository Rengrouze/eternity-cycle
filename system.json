{
   "id": "l5r4ec",
   "title": "Legend of the Five Rings 4th, Eternity Cycle",
   "description": "Un système pour la 4ème édition de L5R, uniquement pour moi et mon groupe.",
   "version": "0.0.1",
   "compatibility": {
      "minimum": 14,
      "verified": 14
   },
   "authors": [
      {
         "name": "A.F AKA Kakita Hiriko",
         "discord": "rengret"
      }
   ],
   "esmodules": ["boot.mjs"],
   "styles": ["styles/system-styles.css"],
   "socket": true,
   "documentTypes": {
      "Actor": {
         "character": {
            "htmlFields": ["details.biography"]
