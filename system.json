{
   "id": "l5r4ec",
   "title": "Legend of the Five Rings 4th, Eternity Cycle",
   "description": "Un système pour la 4ème édition de L5R, uniquement pour moi et mon groupe.",
   "version": "0.3.0",
   "compatibility": {
      "minimum": 14,
      "verified": 14
   },
   "authors": [
      {
         "name": "A.F AKA Kakita Hiriko",
         "discord": "rengret"
      }
   ],
   "esmodules": ["boot.mjs"],
   "styles": ["styles/system-styles.css"],
   "socket": true,
   "documentTypes": {
      "Actor": {
         "character": {
            "htmlFields": ["details.biography"]
         }
      },
      "Item": {
         "item": {
            "htmlFields": ["description"]
         },
         "skill": {
            "htmlFields": ["description"]
         },
         "weapon": {
            "htmlFields": ["specialRules", "description", "nemuranaiPower"]
         },
         "armor": {
            "htmlFields": ["specialRules", "description", "nemuranaiPower"]
         },
         "misc": {
            "htmlFields": ["specialRules", "description", "nemuranaiPower"]
         },
         "ammo": {
            "htmlFields": ["specialRules", "description", "nemuranaiPower"]
         },
         "spell": {
            "htmlFields": ["raises", "description"]
         }
      }
   },
   "languages": [
      {
         "lang": "fr",
         "name": "Français",
         "path": "lang/fr.json"
      }
   ],
   "packs": [
      {
         "name": "weapons",
         "label": "Armes de base",
         "path": "packs/weapons",
         "type": "Item",
         "system": "l5r4ec",
         "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
      },
      {
         "name": "armors",
         "label": "Armures de base",
         "path": "packs/armors",
         "type": "Item",
         "system": "l5r4ec",
         "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
      },
      {
         "name": "ammo",
         "label": "Munitions de base",
         "path": "packs/ammo",
         "type": "Item",
         "system": "l5r4ec",
         "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
      },
      {
         "name": "skills",
         "label": "Compétences de base",
         "path": "packs/skills",
         "type": "Item",
         "system": "l5r4ec",
         "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
      },
      {
         "name": "spells",
         "label": "Sorts de base",
         "path": "packs/spells",
         "type": "Item",
         "system": "l5r4ec",
         "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
      }
   ]
}
